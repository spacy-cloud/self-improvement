<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Local reminders (flutter_local_notifications). The notification permission is
         requested at runtime only after the user switched reminders on; the boot permission
         lets the plugin register pending notifications again after a reboot. No exact-alarm
         permission and no foreground service: reminders are inexact alarms. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Steps from Health Connect (BS-97, D-031): the app only READS the step total, only after the
         user switched "Schritte aus Health übernehmen" on and allowed it in the system dialog of
         Health Connect. No write permission, no other kind of health data, no background reading
         (READ_HEALTH_DATA_IN_BACKGROUND) and no extended history (READ_HEALTH_DATA_HISTORY): the
         app looks at the last 7 days while it is open. -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <!-- The app orders the back button itself (a page without history goes to Home, see
         docs/screens/shell.md). With targetSdk 36, Android 16 enables the predictive back
         gesture by default and then would close the app before that order runs; the
         explicit opt-out keeps the documented behaviour on every Android version. -->
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Receivers of flutter_local_notifications for scheduled notifications: the first one
             shows a notification when its alarm fires, the second one registers the pending
             notifications again after a reboot or an app update. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- The privacy explanation Health Connect links to in its permission dialog. Health Connect
             expects an activity for this intent; without one the dialog may not appear. Up to
             Android 13 the intent filter is used, from Android 14 the alias for
             VIEW_PERMISSION_USAGE. -->
        <activity
            android:name=".HealthRationaleActivity"
            android:exported="true"
            android:theme="@style/HealthRationaleTheme">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Health Connect: lets the app see whether it is installed and current (a visibility
             entry, not a permission). -->
        <package android:name="com.google.android.apps.healthdata"/>
    </queries>
</manifest>
