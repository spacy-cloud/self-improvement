<?xml version="1.0" encoding="utf-8"?>
<!--
  The app keeps all data locally in its sandbox and offers its own explicit JSON
  export. The sensitive SQLite database must never leave the device through
  Android cloud backup or device-to-device transfer, so everything is excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
